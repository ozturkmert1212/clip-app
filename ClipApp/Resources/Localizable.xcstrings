    "Capture stopped, clips can't be saved" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama durdu, klip alınamaz"
          }
        }
      }
    },
    "Capture stopped, clips can't be saved. Allow ClipApp under System Settings > Privacy & Security > Screen Recording." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama durdu, klip alınamaz. Sistem Ayarları > Gizlilik ve Güvenlik > Ekran Kaydı'ndan ClipApp'e izin ver."
          }
        }
      }
    },
    "Capturing the main display" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekran yakalanıyor"
          }
        }
      }
    },
    "Capturing the main display instead. This clears once the source is back or you pick another one in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onun yerine ana ekran yakalanıyor. Kaynak geri gelince ya da ayarlardan yenisini seçince düzelir."
          }
        }
      }
    },
    "Capturing · %@" : {
      "localizations" : {
