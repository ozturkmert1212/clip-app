            "value" : "Verildi"
          }
        }
      }
    },
    "If no banner shows up: macOS hides banners because ClipApp captures the screen all the time. Turn on \"Allow notifications when mirroring or sharing the display\" at the top of the Notifications page." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bant görünmüyorsa: ClipApp ekranı sürekli yakaladığı için macOS bantları gizler. Bildirimler sayfasının en üstündeki \"Ekran yansıtılırken veya paylaşılırken bildirimlere izin ver\" seçeneğini aç."
          }
        }
      }
    },
    "Keep separate audio tracks for editing" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
