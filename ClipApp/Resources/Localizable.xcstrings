    "%@ · %lld s buffered" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · tamponda %lld sn"
          }
        }
      }
    },
    "%@ · %lld s buffered (selected source unavailable)" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ · tamponda %lld sn (seçili kaynak kullanılamıyor)"
          }
        }
      }
    },
    "%lld seconds" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld saniye"
          }
        }
      }
    },
    "%lld selected" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%lld seçili"
          }
        }
      }
