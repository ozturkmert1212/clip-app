      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranlar"
          }
        }
      }
    },
    "Don't ask again" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir daha sorma"
          }
        }
      }
    },
    "End %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitiş %@"
          }
        }
      }
    },
    "Every player uses the mixed track. Game audio and microphone are also stored as separate, disabled tracks, so their levels can be changed in the editor. Adds about 1.4 MB per 30 seconds." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her oynatıcı karışık kanalı kullanır. Oyun sesi ve mikrofon ayrıca devre dışı işaretli ayrı kanallar olarak saklanır; böylece düzeyleri editörde değiştirilebilir. 30 saniyede yaklaşık 1,4 MB ekler."
          }
        }
      }
    },
    "FPS" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "FPS"
          }
        }
      }
    },
    "Folder" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasör"
          }
        }
      }
    },
    "For this option, copy ClipApp to the /Applications folder and open it from there. It is currently running from: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu seçenek için ClipApp'i /Applications klasörüne kopyalayıp oradan aç. Şu an şuradan çalışıyor: %@"
          }
        }
      }
    },
    "Game" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oyun"
          }
        }
      }
    },
