        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin Ver"
          }
        }
      }
    },
    "Appears in the chosen corner for a few seconds when a clip is saved or something goes wrong; it never ends up in clips. A system notification is sent as well." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip kaydedilince ya da bir sorun olunca seçilen köşede birkaç saniye görünür; kliplere girmez. Sistem bildirimi ayrıca gönderilir."
          }
        }
      }
    },
