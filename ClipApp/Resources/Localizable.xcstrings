    "About" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hakkında"
          }
        }
      }
    },
    "All Clips" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm Klipler"
          }
        }
      }
    },
    "Allow" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin Ver"
          }
        }
      }
    },
    "Appears in the chosen corner for a few seconds when a clip is saved or something goes wrong; it never ends up in clips. A system notification is sent as well." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip kaydedilince ya da bir sorun olunca seçilen köşede birkaç saniye görünür; kliplere girmez. Sistem bildirimi ayrıca gönderilir."
          }
        }
      }
    },
    "Applications" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar"
          }
        }
      }
    },
    "Ask every time" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her seferinde sor"
          }
        }
      }
    },
    "Audio" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses"
          }
        }
      }
    },
    "Audio was saved as a single track, so game audio and microphone can't be adjusted separately." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses tek kanal olarak kaydedilmiş; oyun sesi ve mikrofon ayrı ayrı ayarlanamaz."
          }
        }
      }
    },
    "Bitrate" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitrate"
          }
        }
      }
    },
    "Bottom left" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sol alt"
          }
        }
      }
    },
    "Bottom right" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sağ alt"
          }
        }
      }
    },
    "Buffer length" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Buffer süresi"
          }
        }
      }
    },
    "Buffer: %lld of %lld s" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tampon: %lld / %lld sn"
          }
        }
      }
    },
    "Can't write to the save folder: %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kayıt klasörüne yazılamıyor: %@"
          }
        }
      }
    },
    "Cancel" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vazgeç"
          }
        }
      }
    },
    "Capture error, retrying" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama hatası, yeniden deneniyor"
          }
        }
      }
    },
    "Capture off" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama kapalı"
          }
        }
      }
    },
    "Capture source" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama kaynağı"
          }
        }
      }
    },
    "Capture stopped" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama durdu"
          }
        }
      }
    },
    "Capture stopped, clips can't be saved" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama durdu, klip alınamaz"
          }
        }
      }
    },
    "Capture stopped, clips can't be saved. Click to open ClipApp's Settings, where the permission is granted." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalama durdu, klip kaydedilemiyor. İznin verildiği ClipApp Ayarları'nı açmak için tıkla."
          }
        }
      }
    },
    "Capturing the main display" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ana ekran yakalanıyor"
          }
        }
      }
    },
    "Capturing the main display instead. This clears once the source is back or you pick another one in Settings." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onun yerine ana ekran yakalanıyor. Kaynak geri gelince ya da ayarlardan yenisini seçince düzelir."
          }
        }
      }
    },
    "Capturing · %@" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yakalanıyor · %@"
          }
        }
      }
    },
    "Changing the source restarts capture and clears the replay buffer." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kaynağı değiştirmek yakalamayı yeniden başlatır ve tekrar tamponunu temizler."
          }
        }
      }
    },
    "Choose" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç"
          }
        }
      }
    },
    "Choose…" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seç…"
          }
        }
      }
    },
    "Clip" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip"
          }
        }
      }
    },
    "Clip saved" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip kaydedildi"
          }
        }
      }
    },
    "Clip shortcut" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip kısayolu"
          }
        }
      }
    },
    "ClipApp only sees this permission after a restart: turn it on in System Settings, then restart." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ClipApp bu izni ancak yeniden başlatılınca görür: Sistem Ayarları'nda aç, sonra yeniden başlat."
          }
        }
      }
    },
    "Clips" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipler"
          }
        }
      }
    },
    "Clips are moved into this game's folder. A new name creates a new game." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klipler bu oyunun klasörüne taşınır. Yeni bir ad yeni bir oyun oluşturur."
          }
        }
      }
    },
    "Clips only get the mixed track. Game audio and microphone can't be adjusted separately afterwards." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliplere yalnızca karışık kanal yazılır. Oyun sesi ve mikrofon sonradan ayrı ayrı ayarlanamaz."
          }
        }
      }
    },
    "Copies the video as it is: instant and lossless. Because a cut can only start on a keyframe (every 2 s), the file keeps up to 2 s of hidden footage before the start; most players skip it." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Videoyu olduğu gibi kopyalar: anında ve kayıpsız. Kesim yalnızca bir anahtar karede (2 sn'de bir) başlayabildiği için dosya, başlangıçtan önce en fazla 2 sn gizli görüntü taşır; çoğu oynatıcı bunu atlar."
          }
        }
      }
    },
    "Copy File" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyayı Kopyala"
          }
        }
      }
    },
    "Copy Files" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dosyaları Kopyala"
          }
        }
      }
    },
