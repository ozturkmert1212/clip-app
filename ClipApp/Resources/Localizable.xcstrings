      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%%%lld"
          }
        }
      }
    },
    "After turning on Screen Recording, restart ClipApp for the change to take effect." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran Kaydı iznini açtıktan sonra değişikliğin geçerli olması için ClipApp'i yeniden başlat."
          }
        }
      }
    },
    "All Clips" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tüm Klipler"
          }
        }
      }
    },
    "Allow" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İzin Ver"
          }
        }
      }
    },
    "Appears in the chosen corner for a few seconds when a clip is saved or something goes wrong; it never ends up in clips. A system notification is sent as well." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klip kaydedilince ya da bir sorun olunca seçilen köşede birkaç saniye görünür; kliplere girmez. Sistem bildirimi ayrıca gönderilir."
          }
        }
      }
    },
    "Applications" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulamalar"
          }
        }
      }
    },
    "Audio" : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses"
          }
        }
      }
    },
    "Audio was saved as a single track, so game audio and microphone can't be adjusted separately." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses tek kanal olarak kaydedilmiş; oyun sesi ve mikrofon ayrı ayrı ayarlanamaz."
