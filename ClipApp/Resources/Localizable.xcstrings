          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekranlar"
          }
        }
      }
    },
    "Each source gets its own audio track: system audio first, then microphone. Most players only play the first one." : {
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Her kaynak ayrı bir ses track'i olur: önce sistem sesi, sonra mikrofon. Çoğu oynatıcı yalnızca ilkini çalar."
          }
        }
      }
    },
    "End %@" : {
      "localizations" : {
